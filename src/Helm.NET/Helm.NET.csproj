<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Helm.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Helm for .NET</Description>
    <PackageTags>Helm Kubernetes</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Helm.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.NET.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="runtimes\**\native\helmshim.dll" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
    <None Include="runtimes\**\native\libhelmshim.so" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
    <None Include="runtimes\**\native\libhelmshim.dylib" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
  </ItemGroup>

</Project>
