<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>Helm.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Helm for .NET</Description>
    <PackageTags>Helm Kubernetes</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Helm.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <HelmVersion>v4.3.0</HelmVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <InternalsVisibleTo Include="Helm.NET.Tests" />
    <AssemblyMetadata Include="HelmVersion" Value="$(HelmVersion)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Update="runtimes\win-x64\native\helm.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\win-arm64\native\helm.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\linux-x64\native\helm" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\linux-arm64\native\helm" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\osx-x64\native\helm" CopyToOutputDirectory="PreserveNewest" />
    <None Update="runtimes\osx-arm64\native\helm" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="runtimes\win-x64\native\helm.exe" LogicalName="Helm.NET.Resources.win-x64.helm.exe" />
    <EmbeddedResource Include="runtimes\win-arm64\native\helm.exe" LogicalName="Helm.NET.Resources.win-arm64.helm.exe" />
    <EmbeddedResource Include="runtimes\linux-x64\native\helm" LogicalName="Helm.NET.Resources.linux-x64.helm" />
    <EmbeddedResource Include="runtimes\linux-arm64\native\helm" LogicalName="Helm.NET.Resources.linux-arm64.helm" />
    <EmbeddedResource Include="runtimes\osx-x64\native\helm" LogicalName="Helm.NET.Resources.osx-x64.helm" />
    <EmbeddedResource Include="runtimes\osx-arm64\native\helm" LogicalName="Helm.NET.Resources.osx-arm64.helm" />
  </ItemGroup>

</Project>
